# Cloud tier. In production (the Docker image) the API and worker refuse to start while a key
# or secret below is missing, short or still a change-me placeholder. Generate each with:
#   openssl rand -hex 32
PORT=8080
API_KEYS=change-me-long-random-key:keystone          # caller-key:tenantId, comma separated (24+ chars each)
STAFF_API_KEYS=change-me-another-long-random-key:ops@keystone   # staff-key:identity: tenant settings and drift reviews (required in production)
POSTGRES_PASSWORD=change-me                           # docker-compose only
PUBLIC_BASE_URL=http://localhost:8080
APPROVAL_SIGNING_SECRET=change-me-32-bytes-minimum    # signs approval and admin links, and dashboard session keys (32+ chars)
PLATFORM_TENANT_ID=keystone                          # partner firms that sign up on the landing page join this tenant
PARTNER_SIGNUP_MODE=automatic                        # automatic (default): a partner firm's account opens at once, signed in; approval: confirm email, then wait for the platform to approve
APPROVAL_TTL_HOURS=168
# Filing requests by text and WhatsApp (V42-V43), through Twilio. Twilio's messaging webhook: <PUBLIC_BASE_URL>/v1/inbound/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=                                    # +1... (a number with US A2P 10DLC registration)
TWILIO_WHATSAPP_FROM=                               # +1... (a WhatsApp sender approved in Twilio)
# Filing requests from Slack (V41): the /file command at <PUBLIC_BASE_URL>/v1/slack/command
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
GOOGLE_CLIENT_ID=                                   # V37: "Sign in with Google" (the same OAuth client id as the web app's)
BASIS_THEORY_API_KEY=                               # V18: Basis Theory private key (token:read): the worker reads a saved card at the payment screen
# Subscriptions (src/billing, V33). Prices are made in Stripe; name them here.
STRIPE_SECRET_KEY=                                  # a restricted key (rk_...): write on Customers, Checkout Sessions, Customer portal; read on Prices
STRIPE_WEBHOOK_SECRET=                              # whsec_... from the webhook endpoint <API>/v1/billing/stripe-webhook
STRIPE_PRICE_ENTERPRISE=                            # price_... for enterprise subscribers
STRIPE_PRICE_PARTNER=                               # price_... for partner firms (a single plan; STRIPE_PARTNER_PRICES replaces it)
STRIPE_PARTNER_PRICES=                              # partner plans (config/partner-pricing.json): payg=price_..,starter=price_..,starter_annual=price_..,growth=..,growth_annual=..,unlimited=..,unlimited_annual=..
STRIPE_TRIAL_DAYS=                                  # optional free trial on new subscriptions
BILLING_REQUIRED=false                              # true: a live filing needs a subscription in good standing (practice filings are always free)
WEB_BASE_URL=http://localhost:3000                  # the web front end (web/): password-reset and sign-in links in emails point here
# Email (src/comms/resend.ts). Without a key every message (approval links, password resets,
# notices) is recorded on the filing but not sent.
RESEND_API_KEY=                                    # from resend.com, for a domain verified there (SPF + DKIM records)
EMAIL_FROM="CoFile <filings@cofile.app>"   # must be on the verified domain
PLATFORM_NAME=CoFile                                     # the site's name on approval pages
SUPPORT_EMAIL=hello@cofile.app                     # where people reach us: named in our own account emails and staff notices
OPS_EMAIL=                                          # where staff are told to place or cancel registered agent orders (defaults to SUPPORT_EMAIL)
REGISTERED_AGENT_PROVIDER_NAME="Registered Agents, Inc."   # decision 9: our registered agent service for partner firms (resold)
REGISTERED_AGENT_ANNUAL_USD=59                      # charged to the firm per business per year, on its Stripe invoices
EMAIL_REPLY_TO=                                    # optional: where replies go
INBOUND_EMAIL_ADDRESS=                             # V40: where firms email filing requests, e.g. file@in.cofile.app (a Resend receiving address)
RESEND_INBOUND_WEBHOOK_SECRET=                     # V40: signing secret (whsec_...) of the Resend webhook for email.received
DATABASE_URL=postgres://filing:filing@localhost:5432/filing   # optional; in-memory store when unset
DATA_ENCRYPTION_KEY=                          # seals SSNs in the database: openssl rand -hex 32 (required in production; never change it once filings exist)
SENSITIVE_RETENTION_DAYS=30                   # days after a filing is completed or aborted before its SSNs are masked for good
ARTIFACT_DIR=./var/artifacts
ARTIFACT_BUCKET=                              # object storage for artifacts when the API and worker are on different machines (Fly: BUCKET_NAME is set for you)
PG_POOL_MAX=5                                 # connections per process (a hosted pooler such as Neon's takes many more)

# Worker tier (runs the background browser; a hosted machine is fine)
IMAGE_TARGET=steel                            # docker compose: browserless image (every browser on Steel); full = bundled Chromium
WORKER_ENABLED=true
PW_CHROMIUM_PATH=/opt/pw-browsers/chromium    # leave unset to use Playwright's bundled browser
BROWSER_PROFILE_DIR=./var/profiles
# Network routes (src/browser/egress.ts). Most portals go direct. Run `npm run probe-sites`
# and give only the ones it reports as not reachable a route their portal serves:
BROWSER_PROXY=                                # default route for every site: proxy URL, steel (Keystone), or empty = direct
SITE_PROXIES=                                 # per-site overrides, e.g. IRS=steel,NY=steel (Missouri: none works hosted; file by hand)
# Steel hosted browsers, for sites routed "steel" (docs/fixed-ip-machine.md). Set the key from the
# deployment's secret store on the worker machine; never commit it.
STEEL_API_KEY=
STEEL_PROFILES=                               # saved sign-ins from npm run steel-login, e.g. nygov:keystone=<profile id>
STEEL_SESSION_TIMEOUT_MS=900000               # per-run cap; Keystone's Steel plan allows at most 15 minutes
DRY_RUN_DEFAULT=true
SITE_CONCURRENCY_IRS=1
SITE_CONCURRENCY_NY=1
SITE_CONCURRENCY_NJ=1

WORKER_ID=worker-1
WORKER_PORT=                                  # worker's /healthz and /wake listener (Fly: 8081); unset = none
WORKER_IDLE_POLL_MS=2000                      # how often an idle worker checks for work (Fly: 600000, with wake)
WORKER_WAKE_URL=                              # API side: the worker's /wake, called when a filing is queued
WORKER_WAKE_TOKEN=                            # shared by API and worker; generate with openssl rand -hex 32

# Vault (EnvVault reads VAULT_<SCOPED KEY>_USERNAME / _PASSWORD / _TOTP_SEED). Keys are scoped
# per service company: "<tenantId>/<key>" -> VAULT_<TENANTID>_<KEY>_...  (e.g. tenant "keystone",
# key "NYGOV" -> VAULT_KEYSTONE_NYGOV_USERNAME). A firm's own login: "<tenant>/<firm>/<key>".
# Type these on the machine itself; never paste them into chat, tickets or the repository.
# Service company "keystone": its NJ login (tenant setting njAccountCredentialKey: "NJ")
VAULT_KEYSTONE_NJ_USERNAME=
VAULT_KEYSTONE_NJ_PASSWORD=
VAULT_KEYSTONE_NJ_TOTP_SEED=
# Service company "keystone": its Missouri SOS login (tenant setting moAccountCredentialKey: "MO")
VAULT_KEYSTONE_MO_USERNAME=
VAULT_KEYSTONE_MO_PASSWORD=
VAULT_KEYSTONE_MO_TOTP_SEED=
# Service company "keystone": its ny.gov service-company login (tenant setting nyGovCredentialKey: "NYGOV")
VAULT_KEYSTONE_NYGOV_USERNAME=
VAULT_KEYSTONE_NYGOV_PASSWORD=
VAULT_KEYSTONE_NYGOV_TOTP_SEED=
# A service company's own worker machine: claim only its own filings
# Service company "keystone": prepaid Florida Sunbiz E-file account (tenant setting flSunbizAccountCredentialKey: "SUNBIZ"), only if flPaymentMethod=sunbiz_account
VAULT_KEYSTONE_SUNBIZ_USERNAME=
VAULT_KEYSTONE_SUNBIZ_PASSWORD=

WORKER_TENANTS=keystone

# Saved signatures (NY PDF upload filings): 32 random bytes, base64. Required in production before
# signatures can be saved or applied; without it the signature routes answer 503.
SIGNATURE_KEY=
