# Cloud tier. In production (the Docker image) the API and worker refuse to start while a key
# or secret below is missing, short or still a change-me placeholder. Generate each with:
#   openssl rand -hex 32
PORT=8080
API_KEYS=change-me-long-random-key:keystone          # caller-key:tenantId, comma separated (24+ chars each)
STAFF_API_KEYS=change-me-another-long-random-key:ops@keystone   # staff-key:identity: tenant settings and drift reviews (required in production)
POSTGRES_PASSWORD=change-me                           # docker-compose only
PUBLIC_BASE_URL=http://localhost:8080
APPROVAL_SIGNING_SECRET=change-me-32-bytes-minimum    # signs approval and admin links (32+ chars)
APPROVAL_TTL_HOURS=168
DATABASE_URL=postgres://filing:filing@localhost:5432/filing   # optional; in-memory store when unset
ARTIFACT_DIR=./var/artifacts
ARTIFACT_BUCKET=                              # object storage for artifacts when the API and worker are on different machines (Fly: BUCKET_NAME is set for you)
PG_POOL_MAX=5                                 # connections per process (a hosted pooler such as Neon's takes many more)

# Worker tier (runs the background browser; a hosted machine is fine)
IMAGE_TARGET=steel                            # docker compose: browserless image (every browser on Steel); full = bundled Chromium
WORKER_ENABLED=true
PW_CHROMIUM_PATH=/opt/pw-browsers/chromium    # leave unset to use Playwright's bundled browser
BROWSER_PROFILE_DIR=./var/profiles
# Network routes (src/browser/egress.ts). Most portals go direct. Run `npm run probe-sites`
# and give only the ones it reports as not reachable a route their portal serves:
BROWSER_PROXY=                                # default route for every site: proxy URL, steel (Keystone), or empty = direct
SITE_PROXIES=                                 # per-site overrides, e.g. IRS=steel,NY=steel (Missouri: none works hosted; file by hand)
# Steel hosted browsers, for sites routed "steel" (docs/fixed-ip-machine.md). Set the key from the
# deployment's secret store on the worker machine; never commit it.
STEEL_API_KEY=
STEEL_PROFILES=                               # saved sign-ins from npm run steel-login, e.g. nygov=<profile id>
STEEL_SESSION_TIMEOUT_MS=900000               # per-run cap; Keystone's Steel plan allows at most 15 minutes
DRY_RUN_DEFAULT=true
SITE_CONCURRENCY_IRS=1
SITE_CONCURRENCY_NY=1
SITE_CONCURRENCY_NJ=1

WORKER_ID=worker-1
WORKER_PORT=                                  # worker's /healthz and /wake listener (Fly: 8081); unset = none
WORKER_IDLE_POLL_MS=2000                      # how often an idle worker checks for work (Fly: 600000, with wake)
WORKER_WAKE_URL=                              # API side: the worker's /wake, called when a filing is queued
WORKER_WAKE_TOKEN=                            # shared by API and worker; generate with openssl rand -hex 32

# Vault (EnvVault reads VAULT_<SCOPED KEY>_USERNAME / _PASSWORD / _TOTP_SEED). Keys are scoped
# per service company: "<tenantId>/<key>" -> VAULT_<TENANTID>_<KEY>_...  (e.g. tenant "keystone",
# key "NYGOV" -> VAULT_KEYSTONE_NYGOV_USERNAME). A firm's own login: "<tenant>/<firm>/<key>".
# Type these on the machine itself; never paste them into chat, tickets or the repository.
# Service company "keystone": its NJ login (tenant setting njAccountCredentialKey: "NJ")
VAULT_KEYSTONE_NJ_USERNAME=
VAULT_KEYSTONE_NJ_PASSWORD=
VAULT_KEYSTONE_NJ_TOTP_SEED=
# Service company "keystone": its Missouri SOS login (tenant setting moAccountCredentialKey: "MO")
VAULT_KEYSTONE_MO_USERNAME=
VAULT_KEYSTONE_MO_PASSWORD=
VAULT_KEYSTONE_MO_TOTP_SEED=
# Service company "keystone": its ny.gov service-company login (tenant setting nyGovCredentialKey: "NYGOV")
VAULT_KEYSTONE_NYGOV_USERNAME=
VAULT_KEYSTONE_NYGOV_PASSWORD=
VAULT_KEYSTONE_NYGOV_TOTP_SEED=
# A service company's own worker machine: claim only its own filings
# Service company "keystone": prepaid Florida Sunbiz E-file account (tenant setting flSunbizAccountCredentialKey: "SUNBIZ"), only if flPaymentMethod=sunbiz_account
VAULT_KEYSTONE_SUNBIZ_USERNAME=
VAULT_KEYSTONE_SUNBIZ_PASSWORD=

WORKER_TENANTS=keystone
