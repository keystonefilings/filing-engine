{
  "name": "keystone-filing-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Front end for the Keystone filing engine: API docs, the white-label CPA and payroll portal, and enterprise self-service. Deploys on Vercel (root directory: web).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/licensed-fonts.mjs unpack && node scripts/card-fonts.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types lib/*.test.ts lib/design/*.test.ts",
    "coverage": "node --experimental-strip-types scripts/coverage.ts",
    "tokens": "node design/build-tokens.mjs",
    "tokens:check": "node design/build-tokens.mjs --check",
    "check:site": "playwright test -c tests/playwright.config.ts",
    "check:a11y": "playwright test -c tests/playwright.config.ts --project=a11y",
    "check:visual": "playwright test -c tests/playwright.config.ts --project=visual",
    "check:visual:update": "playwright test -c tests/playwright.config.ts --project=visual --update-snapshots=changed && node tests/visual/compress.mjs",
    "check:pseudo-locale": "playwright test -c tests/playwright.config.ts --project=pseudo-locale",
    "check:perf": "node tests/perf/budgets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@basis-theory/web-elements": "3.5.0",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.9",
    "axe-core": "^4.10.2",
    "typescript": "5.9.3",
    "wawoff2": "2.0.1"
  }
}
