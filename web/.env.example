# Front end for the Keystone filing engine. Copy to .env.local for local work; on Vercel set these
# under Project Settings > Environment Variables. Nothing here is sent to the browser.

# Base URL of the engine API (the Fly app), no trailing slash.
ENGINE_API_URL=http://127.0.0.1:8080

# Random secret (at least 32 characters) that encrypts sign-in cookies and invite links.
# Changing it signs everyone out and voids every invite link.
PORTAL_SESSION_SECRET=change-me-to-a-long-random-value

# Public address of this site, used to build invite links (e.g. https://portal.keystonefilings.com).
PORTAL_PUBLIC_URL=http://localhost:3000

# Optional: name shown on the platform pages (docs, dashboard). Firm portals use each firm's own brand.
PLATFORM_NAME=Keystone Filing Engine
# Optional: the engine URL to show callers in the docs, if it differs from ENGINE_API_URL.
ENGINE_PUBLIC_URL=
