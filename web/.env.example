# The engine's API, server side only.
ENGINE_API_URL=http://127.0.0.1:8080
# Shown in the docs' examples (defaults to ENGINE_API_URL).
ENGINE_PUBLIC_URL=
# This site's own address, used in staff invite and client intake links.
PORTAL_PUBLIC_URL=http://localhost:3000
# Seals session cookies and invite links: a random value of at least 32 characters.
PORTAL_SESSION_SECRET=
# Portal filings are dry runs unless this is "true".
PORTAL_LIVE_FILINGS=false
# Name shown on the docs and dashboard.
PLATFORM_NAME=Keystone Filings
