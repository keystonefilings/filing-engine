# The engine's API, server side only.
ENGINE_API_URL=http://127.0.0.1:8080
# Shown in the docs' examples (defaults to ENGINE_API_URL).
ENGINE_PUBLIC_URL=
# This site's own address, used in staff invite and client intake links.
PORTAL_PUBLIC_URL=http://localhost:3000
# Seals session cookies and invite links: a random value of at least 32 characters.
PORTAL_SESSION_SECRET=
# Portal filings are dry runs unless this is "true".
PORTAL_LIVE_FILINGS=false
# Name shown on the docs and dashboard.
PLATFORM_NAME=CoFile
# The platform's own tenant (same as the engine's PLATFORM_TENANT_ID). Its dashboard shows partner sign-ups and enterprise requests.
PLATFORM_TENANT_ID=keystone
# Same as the engine's PARTNER_SIGNUP_MODE, so the sign-up page says whether new accounts wait for approval.
PARTNER_SIGNUP_MODE=approval
# Optional: an API key of the platform tenant. With it, client links that partner firms make carry no key and last 30 days;
# without it, such a link carries the partner's session key and ends when that session does (at most 7 days).
PLATFORM_API_KEY=
# Let search engines index the site (robots). Off until launch.
SITE_INDEXABLE=false
